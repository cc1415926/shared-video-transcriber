# Optional. Copy this file to .env, fill only what you need, then restart.
# Never publish .env or your API key. Ordinary transcription needs no API key.
#
# VIDEO_AI_BASE_URL=https://your-provider.example/v1
# VIDEO_AI_MODEL=your-model-name
# VIDEO_AI_API_KEY=your-key
#
# Optional local storage / port:
# VIDEO_DATA_DIR=E:/VideoInboxData
# VIDEO_PORT=7860
# VIDEO_OPEN_BROWSER=0
#
# Optional Windows-only WeChat Channels collector. Install it independently,
# then configure its root folder (containing wx_channel.exe and downloads\\).
# Do not copy another user's account state, certificate, or downloaded files.
# WX_CHANNEL_HOME=C:/Tools/wx_channel
#
# If its executable and download directory are separate, configure both:
# WX_CHANNEL_DOWNLOADS_DIR=C:/Tools/wx_channel/downloads
# WX_CHANNEL_EXECUTABLE=C:/Tools/wx_channel/wx_channel.exe
#
# Process environment variables take priority over this file.
